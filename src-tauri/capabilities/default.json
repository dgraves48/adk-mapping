{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    "fs:allow-copy-file",
    "fs:allow-remove",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-seek",
    "fs:allow-write-file",
    "fs:allow-write"
  ]
}